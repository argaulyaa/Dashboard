# O-RAN Control Dashboard Environment Variables Example
# Duplicate this file as '.env' in the backend directory to customize configuration.

# Database Connection URL (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:***@localhost:5432/oran_dashboard

# Default Admin User credentials (Format: "user:pass,user2:pass2")
# ORAN_USERS=admin:admin

# --- OAI 5G Core via Kubernetes (CARA AKTIF SAAT INI — 2026-08-26) ---
# 5GC jalan di cluster K8s, namespace 5g-core (NF pods: oai-amf/smf/upf/nrf/
# ausf/udm/udr di worker 'core'). Adapter membaca state via kubectl over SSH
# ke node master yang memegang admin.conf (root-only, dibungkus sudo -S).
# Selama OAI_K8S_SSH_HOST terisi, jalur Docker legacy di bawah diabaikan.
# OAI_K8S_SSH_HOST=10.91.2.156
# OAI_K8S_SSH_PORT=22
# OAI_K8S_SSH_USER=telmat
# OAI_K8S_SSH_PASSWORD=changeme
# K8S_SUDO_PASSWORD=changeme
# OAI_K8S_NAMESPACE=5g-core
# OAI_K8S_ADMIN_CONF=/etc/kubernetes/admin.conf
# Override pemetaan comp_id -> prefix pod (opsional; default sudah sesuai testbed):
# OAI_K8S_COMPONENT_MAP={"amf":"oai-amf","smf":"oai-smf","upf":"oai-upf","nrf":"oai-nrf","ausf":"oai-ausf","udm":"oai-udm","udr":"oai-udr"}

# --- open5GS 5G Core via Kubernetes (helm chart open5gs-chart, ns open5gs-chart) ---
# Adapter clone dari OAI K8s tapi label app.kubernetes.io/name=<comp_id>.
# SSH host fallback ke OAI_K8S_SSH_HOST (10.91.2.156) jika OPEN5GS_K8S_SSH_HOST kosong.
# Namespace default open5gs-chart (fallback open5gs jika chart lama).
# OPEN5GS_K8S_SSH_HOST=10.91.2.156
# OPEN5GS_K8S_SSH_PORT=22
# OPEN5GS_K8S_SSH_USER=telmat
# OPEN5GS_K8S_SSH_PASSWORD=changeme
# OPEN5GS_K8S_SUDO_PASSWORD=changeme
# OPEN5GS_K8S_NAMESPACE=open5gs-chart
# OPEN5GS_K8S_ADMIN_CONF=/etc/kubernetes/admin.conf
# OPEN5GS_K8S_COMPONENT_MAP={"amf":"open5gs-amf","smf":"open5gs-smf","upf":"open5gs-upf","nrf":"open5gs-nrf","ausf":"open5gs-ausf","udm":"open5gs-udm","udr":"open5gs-udr","pcf":"open5gs-pcf","bsf":"open5gs-bsf","nssf":"open5gs-nssf","scp":"open5gs-scp","mongodb":"open5gs-mongodb"}

# OAI 5G Core Docker Container Mapping (LEGACY — hanya untuk testbed compose lama)
# OAI_CORE_CONTAINERS={"amf":"oai-amf","smf":"oai-smf","upf":"oai-upf","nrf":"oai-nrf","ausf":"oai-ausf","udm":"oai-udm","udr":"oai-udr"}
# OAI_DOCKER_HOST=tcp://localhost:2375

# --- OAI Core via SSH (LEGACY — mini PC testbed Docker versi lama) ---
# Backend menjalankan perintah docker di node Core lewat SSH (paramiko),
# tanpa perlu mengekspos Docker daemon via TCP.
# OAI_SSH_HOST=10.91.2.151
# OAI_SSH_PORT=22
# OAI_SSH_USER=core
# OAI_SSH_PASSWORD=changeme

# --- open5gs Core bare-metal via systemd (node `core`, 10.91.2.151) ---
# Testbed bare-metal 3 PC (Nov 2026): Open5GS v2.8.0 jalan langsung sebagai
# systemd unit di OS node Core, BUKAN Docker/K8s. Provider terpisah dari
# OPEN5GS_K8S_* / OPEN5GS_CORE_CONTAINERS di atas — tab baru "open5GS
# (bare-metal)" muncul otomatis di UI kalau host ini diisi.
# OPEN5GS_SYSTEMD_SSH_HOST=10.91.2.151
# OPEN5GS_SYSTEMD_SSH_PORT=22
# OPEN5GS_SYSTEMD_SSH_USER=core
# OPEN5GS_SYSTEMD_SSH_PASSWORD=changeme
# OPEN5GS_SYSTEMD_SUDO_PASSWORD=changeme
# Core bare-metal (10.91.2.151) hanya menerima publickey auth (password SSH
# dimatikan oleh admin jaringan lab) — isi path private key ed25519 kalau
# perlu, kosongkan untuk fallback password biasa:
# OPEN5GS_SYSTEMD_SSH_KEY_PATH=/home/ubuntu/.ssh/telmat_core_key
# Override pemetaan comp_id -> nama unit systemd (opsional; default 11 NF):
# OPEN5GS_SYSTEMD_UNITS={"amf":"open5gs-amfd","smf":"open5gs-smfd","upf":"open5gs-upfd","nrf":"open5gs-nrfd","ausf":"open5gs-ausfd","udm":"open5gs-udmd","udr":"open5gs-udrd","pcf":"open5gs-pcfd","nssf":"open5gs-nssfd","scp":"open5gs-scpd","bsf":"open5gs-bsfd"}

# --- RAN (gNB) via SSH — node mini PC RAN testbed ---
# Aktif kalau OAI_SSH_RAN_HOST diisi. Mendeteksi OAI nr-softmodem / srsRAN `gnb`.
# OAI_SSH_RAN_HOST=10.91.2.152
# OAI_SSH_RAN_PORT=22
# OAI_SSH_RAN_USER=ran
# OAI_SSH_RAN_PASSWORD=changeme

# --- srsRAN (gNB) via SSH --- 
# Aktif kalau SRSRAN_SSH_HOST diisi. Monitoring srsRAN gNB secara terpisah.
# SRSRAN_SSH_HOST=10.91.2.152
# SRSRAN_SSH_PORT=22
# SRSRAN_SSH_USER=ran
# SRSRAN_SSH_PASSWORD=changeme

# --- RIC FlexRIC nearRT-RIC via SSH bare-metal (10.91.2.153) / K8s ns ric ---
# Prioritas: RIC_K8S_SSH_HOST jika terisi -> K8s ns ric via kubectl@10.91.2.156,
# else RIC_SSH_HOST -> bare-metal SSH@10.91.2.153 (ps/ss/ping, SCTP :36421).
# RIC_SSH_HOST=10.91.2.153
# RIC_SSH_PORT=22
# RIC_SSH_USER=telmat
# RIC_SSH_PASSWORD=changeme
# K8s FlexRIC (optional, ketika deployment hostNetwork di ns ric sudah ready):
# RIC_K8S_SSH_HOST=10.91.2.156
# RIC_K8S_SSH_PORT=22
# RIC_K8S_SSH_USER=telmat
# RIC_K8S_SSH_PASSWORD=changeme
# RIC_K8S_SUDO_PASSWORD=changeme
# RIC_K8S_NAMESPACE=ric
# RIC_K8S_ADMIN_CONF=/etc/kubernetes/admin.conf
